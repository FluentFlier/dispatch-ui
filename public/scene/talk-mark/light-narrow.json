/ s;\n  float CELL = 5.4;\n  float2 cell = floor(u / CELL);\n  float2 cc = (cell + 0.5) * CELL;\n  // drawn opaque, one meaning per channel: red is presence, blue is the answer\n  float h = CELL * 0.25;\n  float a = 0.0;\n  float w = 0.0;\n  float litSum = 0.0;\n  for (int k = 0; k < 4; k++) {\n    float2 o = float2((k == 0 || k == 2) ? -h : h, k < 2 ? -h : h);\n    half4 tp = unpremul(inputImage.eval((cc + o) * s));\n    w += tp.a;\n    a += tp.r * tp.a;\n    litSum += tp.b * tp.a;\n  }\n  if (w < 0.02) { return half4(0.0); }\n  float lit = clamp(litSum / max(w, 0.0001), 0.0, 1.0);\n  a *= 0.25;\n  float wv = sin(dot(cc, float2(0.009, -0.006)) - phase);\n  float crest = smoothstep(0.6, 1.0, wv);\n  float r = CELL * 0.5 * sqrt(a) * (0.84 + 0.26 * crest);\n  float d = length(u - cc);\n  float cov = 1.0 - smoothstep(r - 0.6, r + 0.5, d);\n  float strength = mix(ink.a, glint.a, lit);\n  half3 col = mix(ink.rgb, glint.rgb, lit);\n  return half4(col * strength * cov, strength * cov);\n}\n","capability":{"requires":["runtime-effect"],"fallback":"passthrough","maxTemporarySurfaces":1},"parameters":[{"id":"phase","name":"phase","valueType":"number","minimum":0,"maximum":7,"value":{"kind":"keyframed","keyframes":[{"id":"talk.phase.0","tick":0,"value":0,"interpolation":"linear"},{"id":"talk.phase.1","tick":2544,"value":6.283185307179586,"interpolation":"hold"}]}},{"id":"ink","name":"ink","valueType":"color","value":{"kind":"constant","value":{"r":0.06274509803921569,"g":0.06666666666666667,"b":0.0784313725490196,"a":0.3}}},{"id":"glint","name":"glint","valueType":"color","value":{"kind":"constant","value":{"r":0.1843137254901961,"g":0.3568627450980392,"b":0.9176470588235294,"a":0.7}}}]}},"rootNodeIds":["talk"]}},"markers":[],"design":{"tokens":{"looping":true}},"capabilities":{"required":[],"optional":[],"unsupportedPolicy":"warn"},"revision":"sha256:6143ba9b94bac52bfaa1118e51e4510a4f1a0d38684b084e9308234d25a72e47"}