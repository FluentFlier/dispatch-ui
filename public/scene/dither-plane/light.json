{"version":2,"id":"contentos-dither-plane-light","name":"ContentOS plane, halftone","canvas":{"width":1000,"height":1000,"pixelAspectRatio":1,"backgroundColor":{"r":0,"g":0,"b":0,"a":0}},"timing":{"ticksPerSecond":240,"frameRate":{"numerator":60,"denominator":1},"durationTicks":2160,"displayStartTick":0},"assets":{"plane":{"id":"plane","type":"image","uri":"plane.png","width":512,"height":512,"mimeType":"image/png"}},"rootCompositionId":"main","components":{},"compositions":{"main":{"id":"main","name":"Main","width":1000,"height":1000,"durationTicks":2160,"nodes":{"mark":{"id":"mark","name":"mark","visible":true,"inTick":0,"outTick":2160,"opacity":{"kind":"constant","value":1},"transform":{"position":{"kind":"constant","value":{"x":500,"y":500,"z":0}},"anchor":{"kind":"constant","value":{"x":0,"y":0,"z":0}},"scale":{"kind":"constant","value":{"x":1,"y":1,"z":1}},"rotation":{"kind":"constant","value":{"x":0,"y":0,"z":0}},"skew":{"kind":"constant","value":{"x":0,"y":0}}},"blendMode":"normal","type":"image","assetId":"plane","size":{"kind":"constant","value":{"width":1000,"height":1000}},"fit":"contain"},"dots":{"id":"dots","name":"dots","visible":true,"inTick":0,"outTick":2160,"opacity":{"kind":"constant","value":1},"transform":{"position":{"kind":"constant","value":{"x":0,"y":0,"z":0}},"anchor":{"kind":"constant","value":{"x":0,"y":0,"z":0}},"scale":{"kind":"constant","value":{"x":1,"y":1,"z":1}},"rotation":{"kind":"constant","value":{"x":0,"y":0,"z":0}},"skew":{"kind":"constant","value":{"x":0,"y":0}}},"blendMode":"normal","type":"effect","effect":"custom-sksl","inputId":"mark","implementation":"\nuniform shader inputImage;\nuniform float phase;\nuniform half4 ink;\nuniform half4 glint;\nuniform float2 renderScale;\n\nhalf4 main(float2 p) {\n  float s = renderScale.x;\n  float2 u = p / s;\n  float CELL = 11.0;\n  float2 cell = floor(u / CELL);\n  float2 cc = (cell + 0.5) * CELL;\n  half4 src = unpremul(inputImage.eval(cc * s));\n  if (src.a < 0.02) return half4(0.0);\n  float lum = dot(src.rgb, half3(0.299, 0.587, 0.114));\n  // fills keep a floor of tone so every part of the mark reads; the outline is densest\n  float tone = (0.26 + clamp(1.0 - lum, 0.0, 1.0) * 0.74) * src.a;\n  // a slow band of light crossing the mark on the diagonal\n  float wv = sin(dot(cc, float2(0.0058, -0.0041)) - phase);\n  float crest = smoothstep(0.6, 1.0, wv);\n  float r = CELL * 0.5 * sqrt(tone) * (0.8 + 0.34 * crest);\n  float d = length(u - cc);\n  float cov = 1.0 - smoothstep(r - 0.7, r + 0.5, d);\n  half3 col = mix(ink.rgb, glint.rgb, crest * 0.85);\n  return half4(col * cov, cov);\n}\n","capability":{"requires":["runtime-effect"],"fallback":"passthrough","maxTemporarySurfaces":1},"parameters":[{"id":"phase","name":"phase","valueType":"number","minimum":0,"maximum":7,"value":{"kind":"keyframed","keyframes":[{"id":"dots.phase.0","tick":0,"value":0,"interpolation":"linear"},{"id":"dots.phase.1","tick":2160,"value":6.283185307179586,"interpolation":"hold"}]}},{"id":"ink","name":"ink","valueType":"color","value":{"kind":"constant","value":{"r":0.06274509803921569,"g":0.06666666666666667,"b":0.0784313725490196,"a":1}}},{"id":"glint","name":"glint","valueType":"color","value":{"kind":"constant","value":{"r":0.0392156862745098,"g":0.4235294117647059,"b":1,"a":1}}}]}},"rootNodeIds":["dots"]}},"markers":[],"design":{"tokens":{"looping":true}},"capabilities":{"required":[],"optional":[],"unsupportedPolicy":"warn"},"revision":"sha256:3a432d52eece3264ccb765a36afc5fc7d0a3fb4a697847dfa79f84329c24ba75"}