6.0, edge);\n  float CELL = 5.4;\n  float2 cell = floor(u / CELL);\n  float2 cc = (cell + 0.5) * CELL;\n  // drawn opaque, one meaning per channel: red is presence, blue is the ripple\n  float h = CELL * 0.25;\n  float a = 0.0;\n  float w = 0.0;\n  float litSum = 0.0;\n  for (int k = 0; k < 4; k++) {\n    float2 o = float2((k == 0 || k == 2) ? -h : h, k < 2 ? -h : h);\n    half4 tp = unpremul(inputImage.eval((cc + o) * s));\n    w += tp.a;\n    a += tp.r * tp.a;\n    litSum += tp.b * tp.a;\n  }\n  if (w < 0.02) { return half4(0.0); }\n  float lit = clamp(litSum / max(w, 0.0001), 0.0, 1.0);\n  a *= 0.25 * fade;\n  float wv = sin(dot(cc, float2(0.011, -0.007)) - phase);\n  float crest = smoothstep(0.6, 1.0, wv);\n  float r = CELL * 0.5 * sqrt(a) * (0.86 + 0.22 * crest);\n  float d = length(u - cc);\n  float cov = 1.0 - smoothstep(r - 0.5, r + 0.45, d);\n  float strength = mix(ink.a, glint.a, lit);\n  half3 col = mix(ink.rgb, glint.rgb, lit);\n  return half4(col * strength * cov, strength * cov);\n}\n","capability":{"requires":["runtime-effect"],"fallback":"passthrough","maxTemporarySurfaces":1},"parameters":[{"id":"phase","name":"phase","valueType":"number","minimum":0,"maximum":7,"value":{"kind":"keyframed","keyframes":[{"id":"clock.phase.0","tick":0,"value":0,"interpolation":"linear"},{"id":"clock.phase.1","tick":2880,"value":6.283185307179586,"interpolation":"hold"}]}},{"id":"ink","name":"ink","valueType":"color","value":{"kind":"constant","value":{"r":0.8941176470588236,"g":0.9254901960784314,"b":0.9411764705882353,"a":0.27}}},{"id":"glint","name":"glint","valueType":"color","value":{"kind":"constant","value":{"r":0.4235294117647059,"g":0.7764705882352941,"b":0.9215686274509803,"a":0.9}}}]}},"rootNodeIds":["clock"]}},"markers":[],"design":{"tokens":{"looping":true}},"capabilities":{"required":[],"optional":[],"unsupportedPolicy":"warn"},"revision":"sha256:3e672fbcfedc24dc5d41a2eaf803e00ab301feb98b3d40d0083ce5defc26093c"}